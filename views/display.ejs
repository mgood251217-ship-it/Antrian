<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Display Antrian</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background-color: #0d3b66;
        color: white;
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
      }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 30px;
        background-color: #092e52;
        border-bottom: 3px solid #00a8cc;
      }
      .header-left {
        display: flex;
        align-items: center;
        gap: 15px;
      }
      .logo-circle {
        width: 50px;
        height: 50px;
        background-color: #ccc;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        color: black;
        font-weight: bold;
        font-size: 24px;
      }
      .header h1 {
        margin: 0;
        font-size: 28px;
        font-weight: normal;
        letter-spacing: 1px;
      }
      .header .time {
        text-align: right;
      }
      .header .time .clock {
        font-size: 36px;
        color: #ffeb3b;
        margin: 0;
        font-weight: bold;
      }
      .header .time .date {
        font-size: 16px;
        margin: 0;
      }
      .main-content {
        display: flex;
        flex: 1;
        padding: 15px;
        gap: 15px;
      }
      .left-panel {
        flex: 0.35;
        background-color: #1a4a76;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        border: 2px solid #00a8cc;
        box-shadow: inset 0 0 50px rgba(0, 0, 0, 0.3);
      }
      .loket-title {
        font-size: 52px;
        font-weight: bold;
        margin: 0;
      }
      .loket-title span {
        color: #ffeb3b;
      }
      .nomor-title {
        font-size: 26px;
        margin: 30px 0 10px 0;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
      }
      .nomor-value {
        font-size: 90px;
        font-weight: bold;
        color: #ffeb3b;
        margin: 0;
        text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.5);
      }
      .right-panel {
        flex: 0.65;
        border: 2px solid #00a8cc;
        background-color: #000;
        position: relative;
      }
      .bottom-panel {
        display: flex;
        background-color: #1a4a76;
        border-top: 3px solid #00a8cc;
        border-bottom: 3px solid #00a8cc;
      }
      .loket-box {
        flex: 1;
        text-align: center;
        padding: 15px 0;
        border-right: 2px solid #00a8cc;
      }
      .loket-box:last-child {
        border-right: none;
      }
      .loket-box-title {
        font-size: 18px;
        margin: 0 0 10px 0;
        font-weight: bold;
      }
      .loket-box-title span {
        color: #ffeb3b;
      }
      .loket-box-value {
        font-size: 38px;
        font-weight: bold;
        margin: 0;
        color: white;
      }
      .loket-box-value.yellow {
        color: #ffeb3b;
      }
      .marquee-container {
        background-color: #092e52;
        padding: 12px;
        font-size: 28px;
        color: #ffeb3b;
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <div class="header-left">
        <div class="logo-circle">B</div>
        <h1>BANK INDONESIA JAMBI</h1>
      </div>
      <div class="time">
        <p class="clock" id="clock">00:00:00</p>
        <p class="date" id="date">01 January 2026</p>
      </div>
    </div>

    <div class="main-content">
      <div class="left-panel">
        <p class="loket-title">LOKET <span id="main-loket-name">A</span></p>
        <p class="nomor-title">NOMOR ANTRIAN</p>
        <p class="nomor-value" id="main-nomor">A 015</p>
      </div>
      <div class="right-panel">
        <video
          width="100%"
          height="100%"
          controls
          autoplay
          loop
          muted
          style="object-fit: cover"
        >
          <source
            src="https://www.w3schools.com/html/mov_bbb.mp4"
            type="video/mp4"
          />
        </video>
      </div>
    </div>

    <div class="bottom-panel">
      <div class="loket-box">
        <p class="loket-box-title">LOKET <span>1</span></p>
        <p class="loket-box-value yellow" id="val-loket1">A 015</p>
      </div>
      <div class="loket-box">
        <p class="loket-box-title">LOKET <span>2</span></p>
        <p class="loket-box-value yellow" id="val-loket2">A 011</p>
      </div>
      <div class="loket-box">
        <p class="loket-box-title">LOKET <span>3</span></p>
        <p class="loket-box-value yellow" id="val-loket3">A 012</p>
      </div>
      <div class="loket-box">
        <p class="loket-box-title">LOKET <span>4</span></p>
        <p class="loket-box-value" id="val-loket4">B 013</p>
      </div>
      <div class="loket-box">
        <p class="loket-box-title">LOKET <span>5</span></p>
        <p class="loket-box-value" id="val-loket5">B 014</p>
      </div>
    </div>

    <div class="marquee-container">
      <marquee>
        Unlimited running text - Selamat datang di Bank Indonesia Jambi - Harap
        menunggu antrian Anda dipanggil
      </marquee>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      const socket = io();

      socket.on("init_data", (data) => updateUI(data));
      socket.on("update_display", (data) => updateUI(data));

      function updateUI(data) {
        document.getElementById("main-nomor").innerText = data.loketA;
        document.getElementById("main-loket-name").innerText =
          data.currentLoket;

        document.getElementById("val-loket1").innerText = data.loket1;
        document.getElementById("val-loket2").innerText = data.loket2;
        document.getElementById("val-loket3").innerText = data.loket3;
        document.getElementById("val-loket4").innerText = data.loket4;
        document.getElementById("val-loket5").innerText = data.loket5;
      }

      function updateTime() {
        const now = new Date();
        document.getElementById("clock").innerText =
          now.toLocaleTimeString("id-ID");
        document.getElementById("date").innerText = now.toLocaleDateString(
          "id-ID",
          { day: "2-digit", month: "long", year: "numeric" },
        );
      }

      setInterval(updateTime, 1000);
      updateTime();

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
          window.location.href = "/";
        }
      });
    </script>
  </body>
</html>
