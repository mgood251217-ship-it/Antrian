<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pilih Akses</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background-color: #e0e5ec;
        margin: 0;
      }
      .container {
        display: flex;
        gap: 30px;
      }
      .card {
        background: #fff;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        text-align: center;
        width: 250px;
        cursor: pointer;
        transition: transform 0.3s;
        text-decoration: none;
        color: #333;
      }
      .card:hover {
        transform: translateY(-10px);
      }
      .card h2 {
        margin: 0 0 15px 0;
        color: #092e52;
      }
      .card p {
        margin: 0;
        color: #666;
      }
      .icon {
        font-size: 50px;
        margin-bottom: 20px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <a href="/login-user" class="card">
        <div class="icon">🎤</div>
        <h2>User / Petugas</h2>
        <p>Masuk sebagai Pemanggil Loket</p>
      </a>
      <a href="/login-server" class="card">
        <div class="icon">📺</div>
        <h2>Server / Admin</h2>
        <p>Masuk sebagai Tampilan Display</p>
      </a>
    </div>
  </body>
</html>
